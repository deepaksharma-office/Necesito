{% comment %}
  Introductory hero for the Local Events page.
  @example
  Used as the first section in the page.events template.
{% endcomment %}

<section class="local-events-hero" style="--events-hero-bg: {{ section.settings.background }}; --events-hero-accent: {{ section.settings.accent }}; --events-hero-text: {{ section.settings.text_color }};">
  <div class="local-events-hero__inner">
    <div class="local-events-hero__copy">
      {% if section.settings.eyebrow != blank %}<p class="local-events-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1>{{ section.settings.heading | escape }}</h1>
      {% if section.settings.text != blank %}<div class="local-events-hero__text rte">{{ section.settings.text }}</div>{% endif %}
      <a class="local-events-hero__link" href="#local-events-calendar">{{ section.settings.cta_label | escape }} <span aria-hidden="true">↓</span></a>
    </div>
    <div class="local-events-hero__art" aria-hidden="true">
      <span class="local-events-hero__sun"></span>
      <svg viewBox="0 0 360 240" focusable="false"><path d="M64 180h216c20 0 36-16 36-36s-16-36-36-36h-20" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round"/><path d="M54 76h210v82c0 34-28 62-62 62h-86c-34 0-62-28-62-62V76Z" fill="var(--events-hero-bg)" stroke="currentColor" stroke-width="12"/><path d="M105 41c-18 15 17 23 0 39M159 32c-18 15 17 23 0 39M213 41c-18 15 17 23 0 39" fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round"/></svg>
    </div>
  </div>
</section>

{% stylesheet %}
  .local-events-hero { overflow: hidden; color: var(--events-hero-text); background: var(--events-hero-bg); }
  .local-events-hero__inner { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(260px, .75fr); align-items: center; gap: clamp(32px, 7vw, 100px); width: min(calc(100% - 40px), 1320px); margin-inline: auto; padding-block: clamp(64px, 9vw, 124px); }
  .local-events-hero__copy { max-width: 760px; }
  .local-events-hero__eyebrow { margin: 0 0 18px; color: var(--events-hero-accent); font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .local-events-hero h1 { max-width: 12ch; margin: 0; color: inherit; font-size: clamp(42px, 6vw, 78px); line-height: .98; letter-spacing: -.04em; text-wrap: balance; }
  .local-events-hero__text { max-width: 650px; margin-top: 26px; font-size: clamp(16px, 1.6vw, 20px); line-height: 1.6; }
  .local-events-hero__link { display: inline-flex; gap: 14px; align-items: center; margin-top: 30px; color: inherit; font-weight: 700; text-underline-offset: 5px; }
  .local-events-hero__art { position: relative; color: var(--events-hero-text); }
  .local-events-hero__art svg { position: relative; z-index: 1; width: 100%; }
  .local-events-hero__sun { position: absolute; inset: 2% 5% auto auto; width: 74%; aspect-ratio: 1; border-radius: 50%; background: color-mix(in srgb, var(--events-hero-accent) 24%, transparent); }
  @media (max-width: 749px) { .local-events-hero__inner { grid-template-columns: 1fr; padding-block: 52px 58px; } .local-events-hero__art { max-width: 320px; margin-inline: auto; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Local events hero",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "COMMUNITY & CONNECTION" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's Happening in the Neighborhood" },
    { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Discover local happenings, community gatherings, special events, and occasional Necesito Coffee Roasters events right here in Estero.</p>" },
    { "type": "text", "id": "cta_label", "label": "Calendar link label", "default": "Explore the calendar" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f5efe5" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#174c3b" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#c8683b" }
  ],
  "presets": [{ "name": "Local events hero" }]
}
{% endschema %}
