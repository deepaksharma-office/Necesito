{% comment %}
  Compact information bar composed from reusable icon-with-text items.
  @example
  Add “Icon text bar” after the hero and configure each information block.
{% endcomment %}

{{ 'icon-text-bar.css' | asset_url | stylesheet_tag }}

{% if section.settings.enabled %}
  {% liquid
    assign alignment_value = 'flex-start'
    if section.settings.alignment == 'center'
      assign alignment_value = 'center'
    elsif section.settings.alignment == 'right'
      assign alignment_value = 'flex-end'
    endif

    assign divider_display = 'none'
    if section.settings.show_dividers
      assign divider_display = 'block'
    endif
  %}

  <section
    class="icon-text-bar icon-text-bar--mobile-{{ section.settings.mobile_layout }}"
    style="--icon-text-bar-background: {{ section.settings.background_color }}; --icon-text-bar-divider-color: {{ section.settings.divider_color }}; --icon-text-bar-divider-display: {{ divider_display }}; --icon-text-bar-content-width: {{ section.settings.content_width }}px; --icon-text-bar-columns: {{ section.settings.columns }}; --icon-text-bar-gap: {{ section.settings.gap }}px; --icon-text-bar-gap-mobile: {{ section.settings.gap_mobile }}px; --icon-text-bar-alignment: {{ alignment_value }}; --icon-text-bar-padding-top: {{ section.settings.padding_top }}px; --icon-text-bar-padding-bottom: {{ section.settings.padding_bottom }}px; --icon-text-bar-padding-top-mobile: {{ section.settings.padding_top_mobile }}px; --icon-text-bar-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px; --icon-text-bar-item-padding-mobile: {{ section.settings.item_padding_mobile }}px; --icon-text-bar-divider-height: {{ section.settings.divider_height }}%; --icon-text-bar-divider-thickness: {{ section.settings.divider_thickness }}px;"
  >
    <div class="icon-text-bar__container">
      <div class="icon-text-bar__items">
        {% for block in section.blocks %}
          {% liquid
            assign heading_color = block.settings.heading_color
            assign description_color = block.settings.description_color
            assign icon_color = block.settings.icon_color
            assign heading_size = block.settings.heading_size
            assign description_size = block.settings.description_size

            if section.settings.override_colors
              assign heading_color = section.settings.heading_color
              assign description_color = section.settings.description_color
              assign icon_color = section.settings.icon_color
            endif

            if section.settings.override_sizes
              assign heading_size = section.settings.heading_size
              assign description_size = section.settings.description_size
            endif
          %}

          <div class="icon-text-bar__item" {{ block.shopify_attributes }}>
            {% render 'hero-icon-with-text', icon_source: block.settings.icon_source, icon: block.settings.icon, custom_image: block.settings.custom_image, custom_image_alt: '', heading: block.settings.heading, description: block.settings.description, text_color: description_color, text_size: description_size, heading_color: heading_color, heading_size: heading_size, heading_weight: section.settings.heading_weight, description_color: description_color, description_size: description_size, description_line_height: section.settings.description_line_height, icon_color: icon_color, icon_size: block.settings.icon_size, gap: section.settings.icon_text_gap, alignment: 'center', url: block.settings.url, class: 'icon-text-bar__content' %}
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Icon text bar",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show section", "default": true },
    { "type": "header", "content": "Background and colors" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f7f1e7" },
    { "type": "color", "id": "divider_color", "label": "Divider color", "default": "#d8d7ca" },
    { "type": "checkbox", "id": "override_colors", "label": "Override all item colors", "default": false },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#173f35", "visible_if": "{{ section.settings.override_colors }}" },
    { "type": "color", "id": "description_color", "label": "Description color", "default": "#667a70", "visible_if": "{{ section.settings.override_colors }}" },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#456553", "visible_if": "{{ section.settings.override_colors }}" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "content_width", "label": "Content maximum width", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 1320, "info": "Use the same value as Hero composition to align both sections." },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "select", "id": "alignment", "label": "Item alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },
    { "type": "select", "id": "mobile_layout", "label": "Mobile layout", "options": [{ "value": "stack", "label": "Stacked" }, { "value": "two-columns", "label": "Two columns" }], "default": "stack" },
    { "type": "checkbox", "id": "show_dividers", "label": "Show dividers", "default": true },
    { "type": "range", "id": "gap", "label": "Item gap", "min": 16, "max": 96, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "gap_mobile", "label": "Mobile item gap", "min": 8, "max": 48, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "icon_text_gap", "label": "Icon-to-text gap", "min": 4, "max": 32, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "divider_height", "label": "Divider height", "min": 20, "max": 100, "step": 5, "unit": "%", "default": 60 },
    { "type": "range", "id": "divider_thickness", "label": "Divider thickness", "min": 1, "max": 4, "step": 1, "unit": "px", "default": 1 },
    { "type": "header", "content": "Typography" },
    { "type": "checkbox", "id": "override_sizes", "label": "Override all item font sizes", "default": false },
    { "type": "range", "id": "heading_size", "label": "Heading font size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 16, "visible_if": "{{ section.settings.override_sizes }}" },
    { "type": "range", "id": "description_size", "label": "Description font size", "min": 10, "max": 22, "step": 1, "unit": "px", "default": 13, "visible_if": "{{ section.settings.override_sizes }}" },
    { "type": "range", "id": "heading_weight", "label": "Heading font weight", "min": 400, "max": 800, "step": 100, "default": 600 },
    { "type": "range", "id": "description_line_height", "label": "Description line height", "min": 100, "max": 200, "step": 5, "unit": "%", "default": 145 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_top_mobile", "label": "Mobile padding top", "min": 0, "max": 96, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Mobile padding bottom", "min": 0, "max": 96, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "item_padding_mobile", "label": "Stacked item spacing", "min": 8, "max": 48, "step": 2, "unit": "px", "default": 18 }
  ],
  "blocks": [
    {
      "type": "information_item",
      "name": "Information item",
      "settings": [
        { "type": "select", "id": "icon_source", "label": "Icon source", "options": [{ "value": "theme", "label": "Theme icon" }, { "value": "custom", "label": "Custom image" }], "default": "theme" },
        { "type": "select", "id": "icon", "label": "Theme icon", "options": [{ "value": "none", "label": "None" }, { "value": "map_pin", "label": "Map pin" }, { "value": "leaf", "label": "Leaf" }, { "value": "plant", "label": "Plant" }, { "value": "star", "label": "Star" }, { "value": "heart", "label": "Heart" }, { "value": "truck", "label": "Truck" }, { "value": "plane", "label": "Plane" }, { "value": "recycle", "label": "Recycle" }, { "value": "stopwatch", "label": "Stopwatch" }], "default": "leaf", "visible_if": "{{ block.settings.icon_source == 'theme' }}" },
        { "type": "image_picker", "id": "custom_image", "label": "Custom icon", "visible_if": "{{ block.settings.icon_source == 'custom' }}" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Information heading" },
        { "type": "text", "id": "description", "label": "Description", "default": "Add supporting information." },
        { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#173f35" },
        { "type": "range", "id": "heading_size", "label": "Heading font size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 16 },
        { "type": "color", "id": "description_color", "label": "Description color", "default": "#667a70" },
        { "type": "range", "id": "description_size", "label": "Description font size", "min": 10, "max": 22, "step": 1, "unit": "px", "default": 13 },
        { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#456553" },
        { "type": "range", "id": "icon_size", "label": "Icon size", "min": 16, "max": 56, "step": 2, "unit": "px", "default": 28 },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon text bar",
      "blocks": [
        { "type": "information_item", "settings": { "icon": "leaf", "heading": "Small-batch roasting", "description": "Care in every batch." } },
        { "type": "information_item", "settings": { "icon": "map_pin", "heading": "Rooted in Estero", "description": "Your neighborhood roaster." } },
        { "type": "information_item", "settings": { "icon": "truck", "heading": "Local delivery", "description": "To The Place at Corkscrew." } }
      ]
    }
  ]
}
{% endschema %}
