{% comment %}
  Two-column neighborhood story introduction with a reusable testimonial card.
  @example
  Add “Testimonial coming soon” to a homepage in the theme editor.
{% endcomment %}

{{ 'testimonial-coming-soon.css' | asset_url | stylesheet_tag }}

{% liquid
  assign card_ratio = 100 | minus: section.settings.left_column_width
%}

<section
  class="testimonial-coming-soon testimonial-coming-soon--align-{{ section.settings.text_alignment }} testimonial-coming-soon--mobile-{{ section.settings.mobile_order }}"
  style="--testimonial-background: {{ section.settings.background_color }}; --testimonial-content-width: {{ section.settings.content_width }}px; --testimonial-padding-top: {{ section.settings.padding_top }}px; --testimonial-padding-bottom: {{ section.settings.padding_bottom }}px; --testimonial-padding-top-mobile: {{ section.settings.padding_top_mobile }}px; --testimonial-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px; --testimonial-column-gap: {{ section.settings.column_gap }}px; --testimonial-left-ratio: {{ section.settings.left_column_width }}fr; --testimonial-right-ratio: {{ card_ratio }}fr; --testimonial-copy-width: {{ section.settings.copy_width }}px; --testimonial-text-alignment: {{ section.settings.text_alignment }}; --testimonial-card-alignment: {{ section.settings.card_alignment }}; --testimonial-heading-gap: {{ section.settings.eyebrow_heading_gap }}px; --testimonial-description-gap: {{ section.settings.heading_description_gap }}px; --testimonial-card-title-gap: {{ section.settings.card_title_gap }}px; --testimonial-card-description-gap: {{ section.settings.card_description_gap }}px; --testimonial-button-gap: {{ section.settings.button_gap }}px; --testimonial-card-padding-mobile: {{ section.settings.card_padding_mobile }}px;"
>
  <div class="testimonial-coming-soon__container">
    <div class="testimonial-coming-soon__layout">
      <div class="testimonial-coming-soon__content">
        {% if section.settings.show_eyebrow %}
          {% render 'hero-eyebrow', content: section.settings.eyebrow, color: section.settings.eyebrow_color, font_size: section.settings.eyebrow_size, font_weight: section.settings.eyebrow_weight, text_transform: 'uppercase', class: 'testimonial-coming-soon__eyebrow' %}
        {% endif %}

        {% render 'hero-title', content: section.settings.heading, heading_tag: section.settings.heading_tag, color: section.settings.heading_color, highlight_color: section.settings.heading_highlight_color, desktop_size: section.settings.heading_size, mobile_size: section.settings.heading_size_mobile, font_weight: section.settings.heading_weight, line_height: section.settings.heading_line_height, letter_spacing: section.settings.heading_letter_spacing, max_width: section.settings.heading_max_width, alignment: section.settings.text_alignment %}

        {% if section.settings.show_description %}
          {% render 'hero-content', content: section.settings.description, color: section.settings.description_color, desktop_size: section.settings.description_size, mobile_size: section.settings.description_size_mobile, line_height: section.settings.description_line_height, max_width: section.settings.description_max_width, font_weight: section.settings.description_weight, alignment: section.settings.text_alignment %}
        {% endif %}
      </div>

      {% render 'testimonial-card', heading: section.settings.card_heading, description: section.settings.card_description, show_quote: section.settings.show_quote, quote_color: section.settings.quote_color, quote_size: section.settings.quote_size, show_badge: section.settings.show_badge, badge_text: section.settings.badge_text, badge_background: section.settings.badge_background, badge_color: section.settings.badge_text_color, badge_size: section.settings.badge_size, card_background: section.settings.card_background, card_border_color: section.settings.card_border_color, card_border_width: section.settings.card_border_width, card_radius: section.settings.card_radius, card_padding: section.settings.card_padding, heading_color: section.settings.card_heading_color, heading_size: section.settings.card_heading_size, description_color: section.settings.card_description_color, description_size: section.settings.card_description_size, show_button: section.settings.show_button, button_label: section.settings.button_label, button_url: section.settings.button_url, button_type: section.settings.button_type, button_background: section.settings.button_background, button_color: section.settings.button_color, button_border_color: section.settings.button_border_color, button_border_width: section.settings.button_border_width, button_radius: section.settings.button_radius, button_size: section.settings.button_size, button_weight: section.settings.button_weight, button_padding_horizontal: section.settings.button_padding_horizontal, button_padding_vertical: section.settings.button_padding_vertical, button_new_tab: section.settings.button_new_tab, button_arrow: section.settings.button_arrow, button_arrow_color: section.settings.button_arrow_color, button_arrow_size: section.settings.button_arrow_size %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonial coming soon",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "header", "content": "Left content" },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show eyebrow", "default": true },
    { "type": "inline_richtext", "id": "eyebrow", "label": "Eyebrow", "default": "NEIGHBORHOOD STORIES" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Good coffee.<br>Even better company." },
    { "type": "select", "id": "heading_tag", "label": "Heading tag", "options": [{ "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }, { "value": "h4", "label": "H4" }], "default": "h2" },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>One neighborhood, so many coffee stories. We can’t wait to hear yours.</p>" },
    { "type": "text_alignment", "id": "text_alignment", "label": "Text alignment", "default": "left" },

    { "type": "header", "content": "Testimonial card" },
    { "type": "inline_richtext", "id": "card_heading", "label": "Card heading", "default": "Your first cup. Your first impression." },
    { "type": "richtext", "id": "card_description", "label": "Card description", "default": "<p>Our neighbors’ coffee stories will appear here after launch. Tried a cup? We’d love to hear from you.</p>" },
    { "type": "checkbox", "id": "show_quote", "label": "Show quotation mark", "default": true },
    { "type": "checkbox", "id": "show_badge", "label": "Show status badge", "default": true },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "Coming soon", "visible_if": "{{ section.settings.show_badge }}" },
    { "type": "checkbox", "id": "show_button", "label": "Show button", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Leave a review", "visible_if": "{{ section.settings.show_button }}" },
    { "type": "url", "id": "button_url", "label": "Button link", "visible_if": "{{ section.settings.show_button }}" },

    { "type": "header", "content": "Section colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#153f33" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#f5f0e6" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#fffaf1" },
    { "type": "color", "id": "heading_highlight_color", "label": "Bold heading", "default": "#d8b678" },
    { "type": "color", "id": "description_color", "label": "Description", "default": "#c8d5cd" },

    { "type": "header", "content": "Card colors" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#fffcf6" },
    { "type": "color", "id": "card_border_color", "label": "Card border", "default": "#dedbd2" },
    { "type": "color", "id": "card_heading_color", "label": "Card heading", "default": "#315f53" },
    { "type": "color", "id": "card_description_color", "label": "Card description", "default": "#68756e" },
    { "type": "color", "id": "quote_color", "label": "Quotation mark", "default": "#8b6936" },
    { "type": "color", "id": "badge_background", "label": "Badge background", "default": "#e4ede5" },
    { "type": "color", "id": "badge_text_color", "label": "Badge text", "default": "#173f35" },

    { "type": "header", "content": "Left typography" },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 10, "max": 22, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "eyebrow_weight", "label": "Eyebrow weight", "min": 400, "max": 800, "step": 100, "default": 600 },
    { "type": "range", "id": "heading_size", "label": "Heading desktop size", "min": 28, "max": 68, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading mobile size", "min": 26, "max": 48, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "heading_weight", "label": "Heading weight", "min": 300, "max": 800, "step": 100, "default": 500 },
    { "type": "range", "id": "heading_line_height", "label": "Heading line height", "min": 90, "max": 150, "step": 5, "unit": "%", "default": 105 },
    { "type": "range", "id": "heading_letter_spacing", "label": "Heading letter spacing", "min": -10, "max": 10, "step": 1, "unit": "%", "default": -2 },
    { "type": "range", "id": "heading_max_width", "label": "Heading maximum width", "min": 260, "max": 720, "step": 20, "unit": "px", "default": 520 },
    { "type": "range", "id": "description_size", "label": "Description desktop size", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "description_size_mobile", "label": "Description mobile size", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "description_line_height", "label": "Description line height", "min": 110, "max": 190, "step": 5, "unit": "%", "default": 150 },
    { "type": "range", "id": "description_max_width", "label": "Description maximum width", "min": 240, "max": 680, "step": 20, "unit": "px", "default": 520 },
    { "type": "range", "id": "description_weight", "label": "Description weight", "min": 300, "max": 700, "step": 100, "default": 400 },

    { "type": "header", "content": "Card typography" },
    { "type": "range", "id": "quote_size", "label": "Quotation mark size", "min": 24, "max": 72, "step": 2, "unit": "px", "default": 42 },
    { "type": "range", "id": "badge_size", "label": "Badge font size", "min": 9, "max": 16, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "card_heading_size", "label": "Card heading size", "min": 20, "max": 40, "step": 1, "unit": "px", "default": 28 },
    { "type": "range", "id": "card_description_size", "label": "Card description size", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 14 },

    { "type": "header", "content": "Button" },
    { "type": "select", "id": "button_type", "label": "Button style", "options": [{ "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }, { "value": "custom", "label": "Custom" }], "default": "custom" },
    { "type": "color", "id": "button_background", "label": "Background", "default": "#fffcf6", "visible_if": "{{ section.settings.button_type == 'custom' }}" },
    { "type": "color", "id": "button_color", "label": "Text", "default": "#173f35", "visible_if": "{{ section.settings.button_type == 'custom' }}" },
    { "type": "color", "id": "button_border_color", "label": "Border", "default": "#687a6e", "visible_if": "{{ section.settings.button_type == 'custom' }}" },
    { "type": "range", "id": "button_border_width", "label": "Border width", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 1 },
    { "type": "range", "id": "button_radius", "label": "Corner radius", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 4 },
    { "type": "range", "id": "button_size", "label": "Font size", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "button_weight", "label": "Font weight", "min": 400, "max": 800, "step": 100, "default": 600 },
    { "type": "range", "id": "button_padding_horizontal", "label": "Horizontal padding", "min": 10, "max": 36, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "button_padding_vertical", "label": "Vertical padding", "min": 6, "max": 20, "step": 1, "unit": "px", "default": 10 },
    { "type": "checkbox", "id": "button_new_tab", "label": "Open in new tab", "default": false },
    { "type": "checkbox", "id": "button_arrow", "label": "Show arrow", "default": true },
    { "type": "color", "id": "button_arrow_color", "label": "Arrow", "default": "#315f53", "visible_if": "{{ section.settings.button_arrow }}" },
    { "type": "range", "id": "button_arrow_size", "label": "Arrow size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 16, "visible_if": "{{ section.settings.button_arrow }}" },

    { "type": "header", "content": "Layout and spacing" },
    { "type": "range", "id": "content_width", "label": "Content maximum width", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 1320 },
    { "type": "range", "id": "left_column_width", "label": "Left column width", "min": 35, "max": 60, "step": 1, "unit": "%", "default": 48 },
    { "type": "range", "id": "copy_width", "label": "Left content maximum width", "min": 280, "max": 720, "step": 20, "unit": "px", "default": 520 },
    { "type": "select", "id": "card_alignment", "label": "Card vertical alignment", "options": [{ "value": "start", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "end", "label": "Bottom" }], "default": "center" },
    { "type": "select", "id": "mobile_order", "label": "Mobile order", "options": [{ "value": "content-first", "label": "Content first" }, { "value": "card-first", "label": "Card first" }], "default": "content-first" },
    { "type": "range", "id": "column_gap", "label": "Desktop column gap", "min": 20, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_top_mobile", "label": "Mobile padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Mobile padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "eyebrow_heading_gap", "label": "Eyebrow to heading", "min": 4, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "heading_description_gap", "label": "Heading to description", "min": 4, "max": 40, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "card_border_width", "label": "Card border width", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 1 },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "card_padding", "label": "Card padding", "min": 20, "max": 72, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "card_padding_mobile", "label": "Mobile card padding", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "card_title_gap", "label": "Header to card heading", "min": 4, "max": 40, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "card_description_gap", "label": "Card heading to description", "min": 4, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "button_gap", "label": "Description to button", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 24 }
  ],
  "presets": [{ "name": "Testimonial coming soon" }]
}
{% endschema %}
