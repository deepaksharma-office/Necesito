{% comment %}
  Merchant-editable FAQ page with ordered category and question blocks.
  @example
  Add this section to a page template and arrange category and FAQ blocks in the desired order.
{% endcomment %}

{{ 'faq-section.css' | asset_url | stylesheet_tag }}

<faq-section-component
  class="faq-section"
  style="
    --faq-max-width: {{ section.settings.max_width }}px;
    --faq-heading-size: {{ section.settings.heading_size }}px;
    --faq-description-size: {{ section.settings.description_size }}px;
    --faq-category-size: {{ section.settings.category_size }}px;
    --faq-question-size: {{ section.settings.question_size }}px;
    --faq-answer-size: {{ section.settings.answer_size }}px;
    --faq-icon-size: {{ section.settings.icon_size }}px;
    --faq-row-padding: {{ section.settings.row_padding }}px;
    --faq-section-padding-top: {{ section.settings.padding_top }}px;
    --faq-section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --faq-background: {{ section.settings.background_color }};
    --faq-heading-color: {{ section.settings.heading_color }};
    --faq-text-color: {{ section.settings.text_color }};
    --faq-muted-color: {{ section.settings.muted_color }};
    --faq-border-color: {{ section.settings.border_color }};
    --faq-accent-color: {{ section.settings.accent_color }};
  "
>
  <div class="faq-section__inner">
    {% if section.settings.heading != blank or section.settings.description != blank %}
      <header class="faq-section__header">
        {% if section.settings.heading != blank %}
          <h1 class="faq-section__heading">{{ section.settings.heading | escape }}</h1>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="faq-section__description rte">{{ section.settings.description }}</div>
        {% endif %}
      </header>
    {% endif %}

    <div class="faq-section__content">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'category' %}
            {% if block.settings.heading != blank %}
              <h2 class="faq-section__category" {{ block.shopify_attributes }}>
                {{ block.settings.heading | escape }}
              </h2>
            {% endif %}
          {% when 'faq' %}
            {% if block.settings.question != blank %}
              <details
                class="faq-section__item"
                {% if block.settings.open_by_default %}open{% endif %}
                {{ block.shopify_attributes }}
              >
                <summary class="faq-section__summary" on:click="/handleSummaryClick">
                  <span class="faq-section__question">{{ block.settings.question | escape }}</span>
                  <span class="faq-section__icon" aria-hidden="true">
                    <svg class="faq-section__icon-plus" viewBox="0 0 24 24" fill="none">
                      <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                    </svg>
                    <svg class="faq-section__icon-minus" viewBox="0 0 24 24" fill="none">
                      <path d="M5 12H19" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                    </svg>
                  </span>
                </summary>
                <div class="faq-section__answer-wrap">
                  <div class="faq-section__answer rte">{{ block.settings.answer }}</div>
                </div>
              </details>
            {% endif %}
        {% endcase %}
      {% endfor %}
    </div>

    {% if section.settings.contact_heading != blank or section.settings.contact_text != blank %}
      <div class="faq-section__contact">
        {% if section.settings.contact_heading != blank %}
          <h2 class="faq-section__contact-heading">{{ section.settings.contact_heading | escape }}</h2>
        {% endif %}
        {% if section.settings.contact_text != blank %}
          <div class="faq-section__contact-text rte">{{ section.settings.contact_text }}</div>
        {% endif %}
        {% if section.settings.contact_link_label != blank and section.settings.contact_link != blank %}
          <a class="faq-section__contact-link" href="{{ section.settings.contact_link }}">
            {{ section.settings.contact_link_label | escape }}
          </a>
        {% endif %}
        {% if section.settings.signature != blank %}
          <div class="faq-section__signature rte">{{ section.settings.signature }}</div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</faq-section-component>

<script src="{{ 'faq-section.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "faq-section-wrapper",
  "settings": [
    { "type": "header", "content": "Introduction" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Everything you need to know about our coffee, roasting, freshness, grinding, and neighborhood delivery.</p>" },
    { "type": "header", "content": "Contact" },
    { "type": "text", "id": "contact_heading", "label": "Heading", "default": "Still have a question?" },
    { "type": "richtext", "id": "contact_text", "label": "Text", "default": "<p>We're a neighborhood coffee roaster, which means there's a real person behind every bag.</p>" },
    { "type": "text", "id": "contact_link_label", "label": "Link label", "default": "Get in touch" },
    { "type": "url", "id": "contact_link", "label": "Link" },
    { "type": "richtext", "id": "signature", "label": "Signature", "default": "<p>Necesito Coffee Roasters LLC<br>Your Neighborhood Roaster<br>Estero, Florida</p>" },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Page heading size", "min": 28, "max": 72, "step": 1, "unit": "px", "default": 52 },
    { "type": "range", "id": "description_size", "label": "Introduction text size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "category_size", "label": "Category title size", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "question_size", "label": "Accordion title size", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "answer_size", "label": "Accordion text size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 16, "max": 40, "step": 1, "unit": "px", "default": 24 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Content width", "min": 600, "max": 1400, "step": 20, "unit": "px", "default": 960 },
    { "type": "range", "id": "row_padding", "label": "Accordion row spacing", "min": 12, "max": 40, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F7F1E7" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#173F33" },
    { "type": "color", "id": "text_color", "label": "Accordion text", "default": "#294A40" },
    { "type": "color", "id": "muted_color", "label": "Introduction and contact text", "default": "#5D6E67" },
    { "type": "color", "id": "border_color", "label": "Dividers", "default": "#C9C9BE" },
    { "type": "color", "id": "accent_color", "label": "Icons and links", "default": "#8B6936" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Category" }
      ]
    },
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Add an answer here.</p>" },
        { "type": "checkbox", "id": "open_by_default", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Necesito FAQ",
      "category": "Text",
      "settings": {
        "heading": "Frequently Asked Questions",
        "description": "<p>Everything you need to know about our coffee, roasting, freshness, grinding, and neighborhood delivery.</p>",
        "contact_heading": "Still have a question?",
        "contact_text": "<p>We're a neighborhood coffee roaster, which means there's a real person behind every bag.</p><p>If you have a question about our coffee, your order, grinding, brewing, or local delivery, please get in touch. We'd be happy to help.</p>",
        "contact_link_label": "Get in touch",
        "contact_link": "shopify://pages/contact",
        "signature": "<p>Necesito Coffee Roasters LLC<br>Your Neighborhood Roaster<br>Estero, Florida</p>"
      },
      "blocks": [
        { "type": "category", "settings": { "heading": "Our Coffee" } },
        { "type": "faq", "settings": { "question": "Where is Necesito coffee roasted?", "answer": "<p>Every bag of Necesito Coffee is small-batch roasted right here in Estero, Florida. We're your neighborhood roaster—our goal is simple: roast great coffee locally and get it into your hands while it's fresh.</p>" } },
        { "type": "faq", "settings": { "question": "Is your coffee freshly roasted?", "answer": "<p>Absolutely. Freshness is one of the biggest advantages of buying from a local roaster. We roast in small batches, package our coffee fresh, and deliver it directly to our customers rather than letting roasted coffee sit on a retail shelf for months.</p>" } },
        { "type": "faq", "settings": { "question": "Where do your coffee beans come from?", "answer": "<p>We source quality green coffee beans from respected specialty-coffee importers and suppliers. Origin will vary depending on the coffee and seasonal availability. As our coffees and roast profiles are finalized, we'll provide specific origin information on each coffee's product page.</p>" } },
        { "type": "faq", "settings": { "question": "Is your coffee high-altitude grown?", "answer": "<p>High-altitude coffee is an important part of our sourcing strategy. We look for quality specialty-grade coffees where elevation, origin, processing, freshness, traceability and, most importantly, how the coffee tastes all work together.</p>" } },
        { "type": "faq", "settings": { "question": "Is your coffee organic?", "answer": "<p>We actively look for high-quality organic coffees when sourcing our green coffee. Because certifications can vary by individual coffee and crop, we'll clearly identify coffees that are Certified Organic rather than making a blanket claim about every coffee we roast.</p>" } },
        { "type": "faq", "settings": { "question": "Is your coffee single origin?", "answer": "<p>Not necessarily. Some Necesito coffees may be blends while others may feature coffee from a single origin. We select coffees based first on quality and flavor. Each product page will identify the coffee appropriately once our final sourcing is established.</p>" } },
        { "type": "category", "settings": { "heading": "Freshness & Grinding" } },
        { "type": "faq", "settings": { "question": "Should I order Whole Bean or Medium Ground (Drip)?", "answer": "<p>Choose Whole Bean if you have a coffee grinder at home. Grinding immediately before brewing generally gives you the freshest flavor.</p><p>Choose Medium Ground (Drip) if you use a traditional automatic drip coffee maker and want your coffee ready to brew when it arrives.</p>" } },
        { "type": "faq", "settings": { "question": "How should I store my coffee?", "answer": "<p>Keep your coffee sealed in its original bag in a cool, dry place away from direct sunlight, heat, moisture, and strong odors. Avoid storing your everyday coffee in the refrigerator, where moisture and odors can affect its flavor.</p>" } },
        { "type": "faq", "settings": { "question": "How much coffee is in each bag?", "answer": "<p>Each bag contains 12 oz of freshly roasted coffee.</p>" } },
        { "type": "faq", "settings": { "question": "What is the best way to brew Necesito coffee?", "answer": "<p>There isn't one perfect method. Automatic drip, pour-over, French press, AeroPress, and other brewing methods can all produce excellent coffee when paired with the appropriate grind size and coffee-to-water ratio.</p><p>As we finalize each roast, we'll add brewing recommendations to help you get the best from each coffee.</p>" } },
        { "type": "category", "settings": { "heading": "Ordering & Local Delivery" } },
        { "type": "faq", "settings": { "question": "Do you offer free local delivery?", "answer": "<p>Yes. We offer FREE local delivery to eligible addresses within our designated neighborhood delivery area.</p>" } },
        { "type": "faq", "settings": { "question": "When will my coffee be delivered?", "answer": "<p>Eligible local orders are typically delivered within 1–2 business days.</p>" } },
        { "type": "faq", "settings": { "question": "How do I know if my address qualifies for local delivery?", "answer": "<p>Simply enter your delivery address during checkout. Our website will automatically determine whether your address is within our current local delivery area.</p>" } },
        { "type": "faq", "settings": { "question": "What happens if I live outside the local delivery area?", "answer": "<p>At this time, we're focused on serving our immediate neighborhood. If your address falls outside our current delivery area, checkout will let you know that delivery is unavailable.</p><p>We're starting local intentionally and plan to broaden our delivery area as Necesito Coffee Roasters grows.</p>" } },
        { "type": "faq", "settings": { "question": "Is there a charge for local delivery?", "answer": "<p>No. Eligible neighborhood delivery is FREE.</p>" } },
        { "type": "category", "settings": { "heading": "Returns & Order Problems" } },
        { "type": "faq", "settings": { "question": "Can I return coffee?", "answer": "<p>Because coffee is a perishable food product, we generally cannot accept returns of opened coffee or coffee purchased in error.</p>" } },
        { "type": "faq", "settings": { "question": "What if there is a problem with my order?", "answer": "<p>We want you to be happy with every Necesito order. If your coffee arrives damaged, you receive the wrong item, or there's another problem with your order, please contact us and we'll work to make it right.</p>" } }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
