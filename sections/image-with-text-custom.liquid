{% comment %}
  Responsive image-with-text section composed from the shared hero content snippets.
  @example
  Add “Image with text custom” and upload one composed illustration.
{% endcomment %}

{{ 'image-with-text-custom.css' | asset_url | stylesheet_tag }}

{% liquid
  assign content_ratio = 100 | minus: section.settings.image_width
  assign image_aspect_value = '4 / 3'
  case section.settings.image_aspect_ratio
    when 'natural'
      assign image_aspect_value = 'auto'
    when 'square'
      assign image_aspect_value = '1 / 1'
    when 'portrait'
      assign image_aspect_value = '3 / 4'
  endcase
  assign content_justify = 'start'
  if section.settings.text_alignment == 'center'
    assign content_justify = 'center'
  elsif section.settings.text_alignment == 'right'
    assign content_justify = 'end'
  endif

  assign image_loading = 'lazy'
  assign image_fetchpriority = 'auto'
  if section.index == 1
    assign image_loading = 'eager'
    assign image_fetchpriority = 'high'
  endif

  assign image_alt = section.settings.image_alt
  if image_alt == blank and section.settings.image != blank
    assign image_alt = section.settings.image.alt
  endif
%}

<section
  class="image-with-text-custom image-with-text-custom--image-{{ section.settings.image_position }} image-with-text-custom--{{ section.settings.image_aspect_ratio }} image-with-text-custom--align-{{ section.settings.text_alignment }} image-with-text-custom--mobile-{{ section.settings.mobile_order }}"
  style="--image-text-background: {{ section.settings.background_color }}; --image-text-media-background: {{ section.settings.image_background }}; --image-text-content-width: {{ section.settings.content_width }}px; --image-text-padding-top: {{ section.settings.padding_top }}px; --image-text-padding-bottom: {{ section.settings.padding_bottom }}px; --image-text-padding-top-mobile: {{ section.settings.padding_top_mobile }}px; --image-text-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px; --image-text-column-gap: {{ section.settings.column_gap }}px; --image-text-media-ratio: {{ section.settings.image_width }}fr; --image-text-content-ratio: {{ content_ratio }}fr; --image-text-vertical-alignment: {{ section.settings.vertical_alignment }}; --image-text-content-justify: {{ content_justify }}; --image-text-copy-width: {{ section.settings.copy_width }}px; --image-text-alignment: {{ section.settings.text_alignment }}; --image-text-alignment-mobile: {{ section.settings.mobile_text_alignment }}; --image-text-aspect-ratio: {{ image_aspect_value }}; --image-text-fit: {{ section.settings.image_fit }}; --image-text-radius: {{ section.settings.image_radius }}px; --image-text-caption-color: {{ section.settings.caption_color }}; --image-text-caption-size: {{ section.settings.caption_size }}px; --image-text-caption-alignment: {{ section.settings.caption_alignment }}; --image-text-eyebrow-gap: {{ section.settings.eyebrow_heading_gap }}px; --image-text-description-gap: {{ section.settings.heading_description_gap }}px; --image-text-button-gap: {{ section.settings.description_button_gap }}px; --image-text-support-gap: {{ section.settings.button_support_gap }}px; --image-text-support-color: {{ section.settings.supporting_text_color }}; --image-text-support-size: {{ section.settings.supporting_text_size }}px;"
>
  <div class="image-with-text-custom__container">
    <div class="image-with-text-custom__grid">
      <div>
        <div class="image-with-text-custom__media">
          {% capture image_markup %}
            {% if section.settings.image != blank %}
              {{ section.settings.image | image_url: width: 2000 | image_tag: widths: '480, 720, 960, 1200, 1600, 2000', sizes: '(min-width: 750px) 50vw, 100vw', loading: image_loading, fetchpriority: image_fetchpriority, alt: image_alt, class: 'image-with-text-custom__image' }}
            {% elsif request.design_mode %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'image-with-text-custom__placeholder' }}
            {% endif %}
          {% endcapture %}

          {% if section.settings.image_link != blank and section.settings.image != blank %}
            <a class="image-with-text-custom__image-link" href="{{ section.settings.image_link }}"{% if section.settings.image_link_label != blank %} aria-label="{{ section.settings.image_link_label | escape }}"{% endif %}>
              {{ image_markup }}
            </a>
          {% else %}
            {{ image_markup }}
          {% endif %}
        </div>

        {% if section.settings.image_caption != blank %}
          <div class="image-with-text-custom__caption">{{ section.settings.image_caption }}</div>
        {% endif %}
      </div>

      <div class="image-with-text-custom__content">
        {% if section.settings.show_eyebrow %}
          {% render 'hero-eyebrow', content: section.settings.eyebrow, color: section.settings.eyebrow_color, font_size: section.settings.eyebrow_size, font_weight: section.settings.eyebrow_weight, text_transform: section.settings.eyebrow_transform, class: 'image-with-text-custom__eyebrow' %}
        {% endif %}

        {% render 'hero-title', content: section.settings.heading, heading_tag: section.settings.heading_tag, color: section.settings.heading_color, highlight_color: section.settings.heading_highlight_color, desktop_size: section.settings.heading_size, mobile_size: section.settings.heading_size_mobile, font_weight: section.settings.heading_weight, line_height: section.settings.heading_line_height, letter_spacing: section.settings.heading_letter_spacing, max_width: section.settings.heading_max_width, alignment: section.settings.text_alignment %}

        {% if section.settings.show_description %}
          {% render 'hero-content', content: section.settings.description, color: section.settings.description_color, desktop_size: section.settings.description_size, mobile_size: section.settings.description_size_mobile, line_height: section.settings.description_line_height, max_width: section.settings.description_max_width, font_weight: section.settings.description_weight, alignment: section.settings.text_alignment %}
        {% endif %}

        {% if section.settings.show_button and section.settings.button_label != blank and section.settings.button_url != blank %}
          <div class="image-with-text-custom__button-wrap">
            {% render 'hero-button', label: section.settings.button_label, url: section.settings.button_url, type: section.settings.button_type, background: section.settings.button_background, color: section.settings.button_color, border_color: section.settings.button_border_color, border_width: section.settings.button_border_width, border_radius: section.settings.button_radius, font_size: section.settings.button_size, font_weight: section.settings.button_weight, padding_horizontal: section.settings.button_padding_horizontal, padding_vertical: section.settings.button_padding_vertical, open_in_new_tab: section.settings.button_new_tab, show_arrow: section.settings.button_arrow, arrow_color: section.settings.button_arrow_color, arrow_size: section.settings.button_arrow_size, class: 'image-with-text-custom__button' %}
          </div>
        {% endif %}

        {% if section.settings.supporting_text != blank %}
          <div class="image-with-text-custom__supporting-text">{{ section.settings.supporting_text }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text custom",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "info": "Uses the uploaded image alt text when blank." },
    { "type": "url", "id": "image_link", "label": "Image link" },
    { "type": "text", "id": "image_link_label", "label": "Image link accessible label", "default": "Learn more", "visible_if": "{{ section.settings.image_link != blank }}" },
    { "type": "inline_richtext", "id": "image_caption", "label": "Image caption" },
    { "type": "select", "id": "image_position", "label": "Desktop image position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "range", "id": "image_width", "label": "Image column width", "min": 35, "max": 65, "step": 1, "unit": "%", "default": 50 },
    { "type": "select", "id": "image_aspect_ratio", "label": "Image aspect ratio", "options": [{ "value": "natural", "label": "Natural" }, { "value": "square", "label": "Square" }, { "value": "landscape", "label": "Landscape" }, { "value": "portrait", "label": "Portrait" }], "default": "landscape" },
    { "type": "select", "id": "image_fit", "label": "Image fit", "options": [{ "value": "contain", "label": "Contain" }, { "value": "cover", "label": "Cover" }], "default": "contain" },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 10 },
    { "type": "color", "id": "image_background", "label": "Image area background", "default": "#dce9e3" },
    { "type": "color", "id": "caption_color", "label": "Caption color", "default": "#667a70" },
    { "type": "range", "id": "caption_size", "label": "Caption size", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 12 },
    { "type": "text_alignment", "id": "caption_alignment", "label": "Caption alignment", "default": "left" },

    { "type": "header", "content": "Content" },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show eyebrow", "default": true },
    { "type": "inline_richtext", "id": "eyebrow", "label": "Eyebrow", "default": "A LITTLE CLOSER TO HOME" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "From our roaster to your doorstep." },
    { "type": "select", "id": "heading_tag", "label": "Heading tag", "options": [{ "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }, { "value": "h4", "label": "H4" }], "default": "h2" },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>We’re launching local delivery for our neighbors. Good coffee, with a familiar neighborhood hello.</p>" },
    { "type": "inline_richtext", "id": "supporting_text", "label": "Supporting text", "default": "Delivery schedule & fees coming soon." },
    { "type": "text_alignment", "id": "text_alignment", "label": "Text alignment", "default": "left" },
    { "type": "text_alignment", "id": "mobile_text_alignment", "label": "Mobile text alignment", "default": "left" },

    { "type": "header", "content": "Heading typography" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#456553" },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 10, "max": 22, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "eyebrow_weight", "label": "Eyebrow weight", "min": 400, "max": 800, "step": 100, "default": 600 },
    { "type": "select", "id": "eyebrow_transform", "label": "Eyebrow transform", "options": [{ "value": "none", "label": "None" }, { "value": "uppercase", "label": "Uppercase" }], "default": "uppercase" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#173f35" },
    { "type": "color", "id": "heading_highlight_color", "label": "Bold heading color", "default": "#cf6d3b" },
    { "type": "range", "id": "heading_size", "label": "Heading desktop size", "min": 30, "max": 80, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading mobile size", "min": 26, "max": 52, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "heading_weight", "label": "Heading weight", "min": 300, "max": 800, "step": 100, "default": 500 },
    { "type": "range", "id": "heading_line_height", "label": "Heading line height", "min": 90, "max": 150, "step": 5, "unit": "%", "default": 105 },
    { "type": "range", "id": "heading_letter_spacing", "label": "Heading letter spacing", "min": -10, "max": 10, "step": 1, "unit": "%", "default": -2 },
    { "type": "range", "id": "heading_max_width", "label": "Heading maximum width", "min": 260, "max": 800, "step": 20, "unit": "px", "default": 560 },

    { "type": "header", "content": "Description typography" },
    { "type": "color", "id": "description_color", "label": "Description color", "default": "#667a70" },
    { "type": "range", "id": "description_size", "label": "Description desktop size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "description_size_mobile", "label": "Description mobile size", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "description_line_height", "label": "Description line height", "min": 110, "max": 190, "step": 5, "unit": "%", "default": 150 },
    { "type": "range", "id": "description_max_width", "label": "Description maximum width", "min": 240, "max": 700, "step": 20, "unit": "px", "default": 520 },
    { "type": "range", "id": "description_weight", "label": "Description weight", "min": 300, "max": 700, "step": 100, "default": 400 },
    { "type": "color", "id": "supporting_text_color", "label": "Supporting text color", "default": "#7b857e" },
    { "type": "range", "id": "supporting_text_size", "label": "Supporting text size", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 11 },

    { "type": "header", "content": "Button" },
    { "type": "checkbox", "id": "show_button", "label": "Show button", "default": true },
    { "type": "text", "id": "button_label", "label": "Label", "default": "How local delivery works", "visible_if": "{{ section.settings.show_button }}" },
    { "type": "url", "id": "button_url", "label": "Link", "visible_if": "{{ section.settings.show_button }}" },
    { "type": "select", "id": "button_type", "label": "Style", "options": [{ "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }, { "value": "custom", "label": "Custom" }], "default": "custom" },
    { "type": "color", "id": "button_background", "label": "Custom background", "default": "#ffffff", "visible_if": "{{ section.settings.button_type == 'custom' }}" },
    { "type": "color", "id": "button_color", "label": "Custom text", "default": "#173f35", "visible_if": "{{ section.settings.button_type == 'custom' }}" },
    { "type": "color", "id": "button_border_color", "label": "Custom border", "default": "#456553", "visible_if": "{{ section.settings.button_type == 'custom' }}" },
    { "type": "range", "id": "button_border_width", "label": "Border width", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 1 },
    { "type": "range", "id": "button_radius", "label": "Border radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 6 },
    { "type": "range", "id": "button_size", "label": "Font size", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "button_weight", "label": "Font weight", "min": 400, "max": 800, "step": 100, "default": 600 },
    { "type": "range", "id": "button_padding_horizontal", "label": "Horizontal padding", "min": 12, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "button_padding_vertical", "label": "Vertical padding", "min": 8, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "checkbox", "id": "button_new_tab", "label": "Open in new tab", "default": false },
    { "type": "checkbox", "id": "button_arrow", "label": "Show arrow", "default": true },
    { "type": "color", "id": "button_arrow_color", "label": "Arrow color", "default": "#173f35", "visible_if": "{{ section.settings.button_arrow }}" },
    { "type": "range", "id": "button_arrow_size", "label": "Arrow size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 16, "visible_if": "{{ section.settings.button_arrow }}" },

    { "type": "header", "content": "Layout and spacing" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f7f1e7" },
    { "type": "range", "id": "content_width", "label": "Content maximum width", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 1320 },
    { "type": "range", "id": "copy_width", "label": "Text column maximum width", "min": 280, "max": 760, "step": 20, "unit": "px", "default": 560 },
    { "type": "select", "id": "vertical_alignment", "label": "Content vertical alignment", "options": [{ "value": "start", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "end", "label": "Bottom" }], "default": "center" },
    { "type": "select", "id": "mobile_order", "label": "Mobile order", "options": [{ "value": "image-first", "label": "Image first" }, { "value": "text-first", "label": "Text first" }], "default": "image-first" },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 20, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_top_mobile", "label": "Mobile padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Mobile padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "eyebrow_heading_gap", "label": "Eyebrow to heading", "min": 4, "max": 40, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "heading_description_gap", "label": "Heading to description", "min": 8, "max": 48, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "description_button_gap", "label": "Description to button", "min": 12, "max": 56, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "button_support_gap", "label": "Button to supporting text", "min": 6, "max": 32, "step": 2, "unit": "px", "default": 12 }
  ],
  "presets": [{ "name": "Image with text custom" }]
}
{% endschema %}
