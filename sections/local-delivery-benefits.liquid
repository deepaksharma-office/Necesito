<section
  class="local-delivery-benefits"
  style="--benefits-background: {{ section.settings.background_color }}; --benefits-color: {{ section.settings.text_color }}; --benefits-icon-color: {{ section.settings.icon_color }}; --benefits-divider: {{ section.settings.divider_color }}; --benefits-page-width: {{ section.settings.page_width }}px; --benefits-padding-top: {{ section.settings.padding_top }}px; --benefits-padding-bottom: {{ section.settings.padding_bottom }}px; --benefits-padding-inline: {{ section.settings.padding_inline }}px; --benefits-gap: {{ section.settings.column_gap }}px;"
>
  <div class="local-delivery-benefits__inner">
    <div class="local-delivery-benefits__grid">
      {% for block in section.blocks %}
        <div
          class="local-delivery-benefits__item"
          style="--benefit-font-size: {{ block.settings.text_size }}px; --benefit-icon-size: {{ block.settings.icon_size }}px; --benefit-gap: {{ block.settings.gap }}px;"
          {{ block.shopify_attributes }}
        >
          <span class="local-delivery-benefits__icon" aria-hidden="true">
            {% if block.settings.custom_icon != blank %}
              {{ block.settings.custom_icon | image_url: width: 160 | image_tag: widths: '40, 60, 80, 120, 160', sizes: '40px', loading: 'lazy', alt: '' }}
            {% else %}
              {% case block.settings.icon %}
                {% when 'bean' %}
                  <svg viewBox="0 0 32 32" fill="none"><path d="M23.7 5.4c5.2 5.2 1.3 15.3-4.2 20.8-4.1 4.1-10.5 3.3-13.7.1-3.2-3.2-4-9.6.1-13.7C11.4 7.1 18.5.2 23.7 5.4Z"/><path d="M22.5 5.1c-5 5.4-9.6 9.2-8.8 21.9"/></svg>
                {% when 'cup' %}
                  <svg viewBox="0 0 36 32" fill="none"><path d="M4 12h21v9a7 7 0 0 1-7 7h-7a7 7 0 0 1-7-7v-9Z"/><path d="M25 15h3a4 4 0 1 1 0 8h-3M2 30h27M12 9c-3-3 3-4 0-7M19 9c-3-3 3-4 0-7"/></svg>
                {% when 'cart' %}
                  <svg viewBox="0 0 38 32" fill="none"><path d="M6 24h25V11H11L9 24M4 8h7M13 11V4h12v7M28 11V7h3v4"/><circle cx="12" cy="27" r="3"/><circle cx="29" cy="27" r="3"/><path d="M15 27h11M2 19h6"/></svg>
              {% endcase %}
            {% endif %}
          </span>
          {% if block.settings.text != blank %}
            <span class="local-delivery-benefits__text">{{ block.settings.text | escape }}</span>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .local-delivery-benefits {
    padding-block: var(--benefits-padding-top) var(--benefits-padding-bottom);
    background: var(--benefits-background);
    color: var(--benefits-color);
  }

  .local-delivery-benefits__inner {
    width: min(calc(100% - (2 * var(--benefits-padding-inline))), var(--benefits-page-width));
    margin-inline: auto;
    padding-block-end: 22px;
    border-block-end: 1px solid var(--benefits-divider);
  }

  .local-delivery-benefits__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--benefits-gap);
  }

  .local-delivery-benefits__item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    gap: var(--benefit-gap);
    font-size: var(--benefit-font-size);
    line-height: 1.3;
    text-align: center;
  }

  .local-delivery-benefits__item + .local-delivery-benefits__item { border-inline-start: 1px solid var(--benefits-divider); }

  .local-delivery-benefits__icon {
    display: grid;
    place-items: center;
    flex: 0 0 var(--benefit-icon-size);
    width: var(--benefit-icon-size);
    height: var(--benefit-icon-size);
    color: var(--benefits-icon-color);
  }

  .local-delivery-benefits__icon svg,
  .local-delivery-benefits__icon img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .local-delivery-benefits__icon svg { stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .local-delivery-benefits__text { overflow-wrap: anywhere; }

  @media (max-width: 749px) {
    .local-delivery-benefits__grid { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .local-delivery-benefits__item { justify-content: flex-start; padding-block: 14px; text-align: start; }
    .local-delivery-benefits__item + .local-delivery-benefits__item { border-inline-start: 0; border-block-start: 1px solid var(--benefits-divider); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Local delivery benefits",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 3,
  "settings": [
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f5efe5" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#174c3b" },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#765743" },
    { "type": "color", "id": "divider_color", "label": "Divider color", "default": "#d7cabb" },
    { "type": "range", "id": "page_width", "label": "Maximum width", "min": 720, "max": 1600, "step": 20, "unit": "px", "default": 1320 },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_inline", "label": "Horizontal padding", "min": 16, "max": 80, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [{ "value": "bean", "label": "Coffee bean" }, { "value": "cup", "label": "Coffee cup" }, { "value": "cart", "label": "Golf cart" }], "default": "bean" },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom icon", "info": "Overrides the selected icon." },
        { "type": "text", "id": "text", "label": "Text", "default": "Roasted in Estero" },
        { "type": "range", "id": "text_size", "label": "Text size", "min": 11, "max": 24, "step": 1, "unit": "px", "default": 16 },
        { "type": "range", "id": "icon_size", "label": "Icon size", "min": 20, "max": 56, "step": 2, "unit": "px", "default": 32 },
        { "type": "range", "id": "gap", "label": "Icon and text gap", "min": 4, "max": 32, "step": 2, "unit": "px", "default": 14 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Local delivery benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "bean", "text": "Roasted in Estero" } },
        { "type": "benefit", "settings": { "icon": "cup", "text": "Small-batch freshness" } },
        { "type": "benefit", "settings": { "icon": "cart", "text": "Delivered by golf cart" } }
      ]
    }
  ]
}
{% endschema %}
