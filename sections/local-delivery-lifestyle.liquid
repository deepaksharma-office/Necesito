<section class="delivery-lifestyle" style="--dl-bg:{{ section.settings.background_color }};--dl-width:{{ section.settings.page_width }}px;--dl-gutter:{{ section.settings.padding_inline }}px;--dl-top:{{ section.settings.padding_top }}px;--dl-bottom:{{ section.settings.padding_bottom }}px;--dl-gap:{{ section.settings.column_gap }}px;--dl-image-width:{{ section.settings.image_width }}%;--dl-radius:{{ section.settings.image_radius }}px;">
  <div class="delivery-lifestyle__inner">
    <div class="delivery-lifestyle__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1800 | image_tag: widths: '480, 720, 960, 1200, 1500, 1800', sizes: '(min-width: 750px) 56vw, 92vw', loading: 'lazy', alt: section.settings.image_alt, class: 'delivery-lifestyle__image' }}
      {% elsif request.design_mode %}{{ 'lifestyle-2' | placeholder_svg_tag: 'delivery-lifestyle__placeholder' }}{% endif %}
    </div>
    <div class="delivery-lifestyle__content">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'heading' %}{% if block.settings.text != blank %}<h2 class="delivery-lifestyle__heading" style="--b-color:{{ block.settings.color }};--b-size:{{ block.settings.size }}px;--b-mobile:{{ block.settings.size_mobile }}px;--b-space:{{ block.settings.spacing }}px;" {{ block.shopify_attributes }}>{{ block.settings.text | escape | newline_to_br }}</h2>{% endif %}
          {% when 'text' %}{% if block.settings.text != blank %}<div class="delivery-lifestyle__text" style="--b-color:{{ block.settings.color }};--b-size:{{ block.settings.size }}px;--b-width:{{ block.settings.max_width }}px;--b-space:{{ block.settings.spacing }}px;" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>{% endif %}
          {% when 'link' %}{% if block.settings.label != blank %}<a class="delivery-lifestyle__link" href="{{ block.settings.link | default: '#' }}" style="--b-color:{{ block.settings.color }};--b-size:{{ block.settings.size }}px;--b-space:{{ block.settings.spacing }}px;" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>{% endif %}
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .delivery-lifestyle{padding-block:var(--dl-top) var(--dl-bottom);background:var(--dl-bg)}
  .delivery-lifestyle__inner{display:grid;grid-template-columns:minmax(0,var(--dl-image-width)) minmax(0,1fr);align-items:center;gap:var(--dl-gap);width:min(calc(100% - 2 * var(--dl-gutter)),var(--dl-width));margin-inline:auto}
  .delivery-lifestyle__media{overflow:hidden;min-width:0;border-radius:var(--dl-radius)}.delivery-lifestyle__image,.delivery-lifestyle__placeholder{display:block;width:100%;height:auto;aspect-ratio:1.54;object-fit:cover}
  .delivery-lifestyle__content{min-width:0}.delivery-lifestyle__content>*{margin-block-start:var(--b-space,24px);margin-block-end:0}.delivery-lifestyle__content>:first-child{margin-block-start:0}
  .delivery-lifestyle__heading{color:var(--b-color);font-size:var(--b-size);font-weight:400;line-height:1.08;letter-spacing:-.02em;text-wrap:balance}
  .delivery-lifestyle__text{max-width:var(--b-width);color:var(--b-color);font-size:var(--b-size);line-height:1.45}.delivery-lifestyle__text>*{margin:0}
  .delivery-lifestyle__link{display:inline-block;color:var(--b-color);font-size:var(--b-size);font-weight:700;line-height:1.2;text-underline-offset:7px;text-decoration-thickness:1px}
  .delivery-lifestyle__link:focus-visible{outline:2px solid currentColor;outline-offset:5px}
  @media(max-width:749px){.delivery-lifestyle__inner{grid-template-columns:1fr;gap:34px}.delivery-lifestyle__heading{font-size:var(--b-mobile)}}
{% endstylesheet %}

