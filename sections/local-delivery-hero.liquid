{% comment %}
  Local-delivery hero with merchant-managed content blocks and layered media.
  @example
  Add the section to a page, then select separate oval and vehicle images.
{% endcomment %}

{% liquid
  assign vehicle_loading = 'lazy'
  assign vehicle_fetchpriority = 'auto'
  if section.index == 1
    assign vehicle_loading = 'eager'
    assign vehicle_fetchpriority = 'high'
  endif
%}

<section
  class="local-delivery-hero{% if section.settings.enable_animation %} local-delivery-hero--animated{% endif %}"
  style="--local-delivery-background: {{ section.settings.background_color }}; --local-delivery-page-width: {{ section.settings.page_width }}px; --local-delivery-padding-inline: {{ section.settings.padding_inline }}px; --local-delivery-column-gap: {{ section.settings.column_gap }}px; --local-delivery-block-gap: {{ section.settings.block_gap }}px; --local-delivery-padding-top: {{ section.settings.padding_top }}px; --local-delivery-padding-bottom: {{ section.settings.padding_bottom }}px; --local-delivery-padding-top-mobile: {{ section.settings.padding_top_mobile }}px; --local-delivery-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px; --local-delivery-media-ratio: {{ section.settings.media_aspect_ratio }}; --local-delivery-oval-width: {{ section.settings.oval_width }}%; --local-delivery-vehicle-width: {{ section.settings.vehicle_width }}%; --local-delivery-motion-distance: {{ section.settings.animation_distance }}px; --local-delivery-motion-duration: {{ section.settings.animation_duration }}s;"
>
  <div class="local-delivery-hero__inner">
    <div class="local-delivery-hero__content">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'eyebrow' %}
            {% if block.settings.text != blank %}
              <p class="local-delivery-hero__eyebrow" style="--block-color: {{ block.settings.color }}; --block-size: {{ block.settings.size }}px; --block-weight: {{ block.settings.weight }}; --block-spacing: {{ block.settings.spacing }}px;" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
            {% endif %}
          {% when 'heading' %}
            {% if block.settings.text != blank %}
              <{{ block.settings.heading_tag }} class="local-delivery-hero__heading" style="--block-color: {{ block.settings.color }}; --block-size: {{ block.settings.size }}px; --block-size-mobile: {{ block.settings.size_mobile }}px; --block-weight: {{ block.settings.weight }}; --block-line-height: {{ block.settings.line_height | divided_by: 100.0 }}; --block-spacing: {{ block.settings.spacing }}px;" {{ block.shopify_attributes }}>{{ block.settings.text | escape | newline_to_br }}</{{ block.settings.heading_tag }}>
            {% endif %}
          {% when 'text' %}
            {% if block.settings.text != blank %}
              <div class="local-delivery-hero__text" style="--block-color: {{ block.settings.color }}; --block-size: {{ block.settings.size }}px; --block-size-mobile: {{ block.settings.size_mobile }}px; --block-weight: {{ block.settings.weight }}; --block-line-height: {{ block.settings.line_height | divided_by: 100.0 }}; --block-max-width: {{ block.settings.max_width }}px; --block-spacing: {{ block.settings.spacing }}px;" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {% endif %}
          {% when 'buttons' %}
            <div class="local-delivery-hero__buttons" style="--block-spacing: {{ block.settings.spacing }}px; --button-gap: {{ block.settings.gap }}px;" {{ block.shopify_attributes }}>
              {% if block.settings.primary_label != blank %}
                <a class="local-delivery-hero__button local-delivery-hero__button--primary" href="{{ block.settings.primary_link | default: '#' }}" style="--button-color: {{ block.settings.primary_color }}; --button-background: {{ block.settings.primary_background }}; --button-border: {{ block.settings.primary_background }}; --button-size: {{ block.settings.size }}px; --button-radius: {{ block.settings.radius }}px;">{{ block.settings.primary_label | escape }}<span aria-hidden="true">&rarr;</span></a>
              {% endif %}
              {% if block.settings.secondary_label != blank %}
                <a class="local-delivery-hero__button local-delivery-hero__button--secondary" href="{{ block.settings.secondary_link | default: '#' }}" style="--button-color: {{ block.settings.secondary_color }}; --button-background: transparent; --button-border: transparent; --button-size: {{ block.settings.size }}px; --button-radius: {{ block.settings.radius }}px;">{{ block.settings.secondary_label | escape }}</a>
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    <div class="local-delivery-hero__media"{% if section.settings.media_label != blank %} role="img" aria-label="{{ section.settings.media_label | escape }}"{% endif %}>
      {% if section.settings.oval_image != blank %}
        {{ section.settings.oval_image | image_url: width: 1400 | image_tag: widths: '360, 540, 720, 960, 1200, 1400', sizes: '(min-width: 750px) 48vw, 92vw', loading: 'lazy', alt: '', class: 'local-delivery-hero__oval' }}
      {% else %}
        <span class="local-delivery-hero__oval local-delivery-hero__oval--fallback" aria-hidden="true"></span>
      {% endif %}

      {% if section.settings.vehicle_image != blank %}
        <div class="local-delivery-hero__vehicle-motion">
          {{ section.settings.vehicle_image | image_url: width: 1800 | image_tag: widths: '420, 640, 840, 1080, 1400, 1800', sizes: '(min-width: 750px) 52vw, 96vw', loading: vehicle_loading, fetchpriority: vehicle_fetchpriority, alt: '', class: 'local-delivery-hero__vehicle' }}
        </div>
      {% elsif request.design_mode %}
        <div class="local-delivery-hero__vehicle-motion local-delivery-hero__vehicle-placeholder">
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .local-delivery-hero {
    overflow: visible;
    padding-block: var(--local-delivery-padding-top) var(--local-delivery-padding-bottom);
    background: var(--local-delivery-background);
  }

  .local-delivery-hero__inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: var(--local-delivery-column-gap);
    width: min(calc(100% - (2 * var(--local-delivery-padding-inline))), var(--local-delivery-page-width));
    margin-inline: auto;
  }

  .local-delivery-hero__content { min-width: 0; align-self: center; }
  .local-delivery-hero__content > * { margin-block-start: var(--block-spacing, var(--local-delivery-block-gap)); margin-block-end: 0; }
  .local-delivery-hero__content > :first-child { margin-block-start: 0; }

  .local-delivery-hero__eyebrow {
    color: var(--block-color);
    font-size: var(--block-size);
    font-weight: var(--block-weight);
    line-height: 1.25;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .local-delivery-hero__heading {
    color: var(--block-color);
    font-size: var(--block-size);
    font-weight: var(--block-weight);
    line-height: var(--block-line-height);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .local-delivery-hero__text {
    max-width: var(--block-max-width);
    color: var(--block-color);
    font-size: var(--block-size);
    font-weight: var(--block-weight);
    line-height: var(--block-line-height);
  }

  .local-delivery-hero__text > * { margin: 0; }
  .local-delivery-hero__text > * + * { margin-block-start: 0.75em; }

  .local-delivery-hero__buttons { display: flex; flex-wrap: wrap; align-items: center; gap: var(--button-gap); }

  .local-delivery-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    min-height: 44px;
    padding: 12px 16px;
    border: 1px solid var(--button-border);
    border-radius: var(--button-radius);
    color: var(--button-color);
    background: var(--button-background);
    font-size: var(--button-size);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition: transform var(--animation-speed) ease, opacity var(--animation-speed) ease;
  }

  .local-delivery-hero__button--secondary { padding-inline: 0; text-decoration: underline; text-underline-offset: 0.22em; }
  .local-delivery-hero__button:hover { transform: translateY(-2px); }
  .local-delivery-hero__button:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  /* Desktop grid row height comes only from the content, not the images. */
  .local-delivery-hero__media {
    position: relative;
    align-self: stretch;
    min-width: 0;
    min-height: 0;
    height: 100%;
    isolation: isolate;
  }

  /* Center both layers in the content-height-driven media column. */
  .local-delivery-hero__oval {
    position: absolute;
    z-index: 0;
    display: block;
    top: 50%;
    left: 50%;
    width: var(--local-delivery-oval-width);
    height: 88%;
    max-width: 100%;
    object-fit: contain;
    transform: translate(-50%, -50%);
  }

  .local-delivery-hero__oval--fallback {
    border-radius: 50%;
    background: #dfe7d3;
  }

  .local-delivery-hero__vehicle-motion {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .local-delivery-hero__vehicle {
    display: block;
    flex: none;
    width: var(--local-delivery-vehicle-width);
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .local-delivery-hero__vehicle-placeholder svg {
    display: block;
    width: 90%;
    height: 90%;
  }

  .local-delivery-hero--animated .local-delivery-hero__vehicle-motion {
    animation: local-delivery-drive var(--local-delivery-motion-duration) ease-in-out infinite;
  }

  @keyframes local-delivery-drive {
    0%, 100% { transform: translateX(calc(-1 * var(--local-delivery-motion-distance))) translateY(0) rotate(-0.35deg); }
    50% { transform: translateX(var(--local-delivery-motion-distance)) translateY(-4px) rotate(0.35deg); }
  }

  @media (max-width: 749px) {
    .local-delivery-hero {
      padding-block: var(--local-delivery-padding-top-mobile) var(--local-delivery-padding-bottom-mobile);
    }
    .local-delivery-hero__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }
    .local-delivery-hero__heading { font-size: var(--block-size-mobile); }
    .local-delivery-hero__text { font-size: var(--block-size-mobile); }
    /* Single-column layouts need their own media height, because the content
       occupies a separate grid row. On desktop, no media ratio is used. */
    .local-delivery-hero__media {
      order: 2;
      height: auto;
      aspect-ratio: 100 / var(--local-delivery-media-ratio);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .local-delivery-hero--animated .local-delivery-hero__vehicle-motion { animation: none; }
    .local-delivery-hero__button { transition: none; }
    .local-delivery-hero__button:hover { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Local delivery hero",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f5efe5" },
    { "type": "range", "id": "page_width", "label": "Maximum width", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 1320 },
    { "type": "range", "id": "padding_inline", "label": "Horizontal padding", "min": 16, "max": 80, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "block_gap", "label": "Default block spacing", "min": 0, "max": 64, "step": 2, "unit": "px", "default": 20 },
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "oval_image", "label": "Green oval image" },
    { "type": "range", "id": "oval_width", "label": "Oval width", "min": 40, "max": 100, "step": 1, "unit": "%", "default": 82 },
    { "type": "image_picker", "id": "vehicle_image", "label": "Vehicle image" },
    { "type": "range", "id": "vehicle_width", "label": "Vehicle width", "min": 40, "max": 100, "step": 1, "unit": "%", "default": 92 },
    { "type": "range", "id": "media_aspect_ratio", "label": "Mobile media height ratio", "min": 60, "max": 120, "step": 2, "unit": "%", "default": 84 },
    { "type": "text", "id": "media_label", "label": "Media accessible label", "default": "Necesito local coffee delivery vehicle" },
    { "type": "header", "content": "Animation" },
    { "type": "checkbox", "id": "enable_animation", "label": "Enable vehicle motion", "default": true },
    { "type": "range", "id": "animation_distance", "label": "Travel distance", "min": 2, "max": 32, "step": 1, "unit": "px", "default": 10, "visible_if": "{{ section.settings.enable_animation }}" },
    { "type": "range", "id": "animation_duration", "label": "Animation duration", "min": 2, "max": 12, "step": 1, "unit": "s", "default": 5, "visible_if": "{{ section.settings.enable_animation }}" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_top_mobile", "label": "Mobile padding top", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Mobile padding bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "YOUR NEIGHBORHOOD ROASTER" },
        { "type": "color", "id": "color", "label": "Color", "default": "#654837" },
        { "type": "range", "id": "size", "label": "Font size", "min": 8, "max": 24, "step": 1, "unit": "px", "default": 11 },
        { "type": "range", "id": "weight", "label": "Font weight", "min": 300, "max": 800, "step": 100, "default": 700 },
        { "type": "range", "id": "spacing", "label": "Spacing above", "min": 0, "max": 64, "step": 2, "unit": "px", "default": 0 }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text", "default": "Fresh coffee.\nA familiar face.\nRight to your door." },
        { "type": "select", "id": "heading_tag", "label": "Heading tag", "options": [{ "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }], "default": "h1" },
        { "type": "color", "id": "color", "label": "Color", "default": "#174c3b" },
        { "type": "range", "id": "size", "label": "Desktop font size", "min": 28, "max": 88, "step": 2, "unit": "px", "default": 56 },
        { "type": "range", "id": "size_mobile", "label": "Mobile font size", "min": 26, "max": 60, "step": 2, "unit": "px", "default": 40 },
        { "type": "range", "id": "weight", "label": "Font weight", "min": 300, "max": 800, "step": 100, "default": 400 },
        { "type": "range", "id": "line_height", "label": "Line height", "min": 80, "max": 150, "step": 5, "unit": "%", "default": 105 },
        { "type": "range", "id": "spacing", "label": "Spacing above", "min": 0, "max": 64, "step": 2, "unit": "px", "default": 18 }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Small-batch coffee, roasted in Estero and delivered to your doorstep in The Place at Corkscrew.</p>" },
        { "type": "color", "id": "color", "label": "Color", "default": "#654837" },
        { "type": "range", "id": "size", "label": "Desktop font size", "min": 12, "max": 30, "step": 1, "unit": "px", "default": 18 },
        { "type": "range", "id": "size_mobile", "label": "Mobile font size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
        { "type": "range", "id": "weight", "label": "Font weight", "min": 300, "max": 700, "step": 100, "default": 400 },
        { "type": "range", "id": "line_height", "label": "Line height", "min": 100, "max": 200, "step": 5, "unit": "%", "default": 145 },
        { "type": "range", "id": "max_width", "label": "Maximum width", "min": 240, "max": 800, "step": 20, "unit": "px", "default": 440 },
        { "type": "range", "id": "spacing", "label": "Spacing above", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 58 }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "settings": [
        { "type": "text", "id": "primary_label", "label": "Primary label", "default": "Shop Coffee" },
        { "type": "url", "id": "primary_link", "label": "Primary link" },
        { "type": "color", "id": "primary_background", "label": "Primary background", "default": "#124d3b" },
        { "type": "color", "id": "primary_color", "label": "Primary text", "default": "#ffffff" },
        { "type": "text", "id": "secondary_label", "label": "Secondary label", "default": "How delivery works" },
        { "type": "url", "id": "secondary_link", "label": "Secondary link" },
        { "type": "color", "id": "secondary_color", "label": "Secondary text", "default": "#174c3b" },
        { "type": "range", "id": "size", "label": "Font size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
        { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 4 },
        { "type": "range", "id": "gap", "label": "Button gap", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 26 },
        { "type": "range", "id": "spacing", "label": "Spacing above", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 40 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Local delivery hero",
      "blocks": [
        { "type": "eyebrow" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "buttons" }
      ]
    }
  ]
}
{% endschema %}
