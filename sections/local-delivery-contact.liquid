<section class="delivery-contact" style="--dc-width:{{ section.settings.page_width }}px;--dc-gutter:{{ section.settings.padding_inline }}px;--dc-top:{{ section.settings.padding_top }}px;--dc-bottom:{{ section.settings.padding_bottom }}px;--dc-card:{{ section.settings.background_color }};--dc-color:{{ section.settings.text_color }};--dc-radius:{{ section.settings.corner_radius }}px;--dc-pad:{{ section.settings.card_padding }}px;--dc-image:{{ section.settings.image_width }}px;">
  <div class="delivery-contact__inner">
    <div class="delivery-contact__card">
      <div class="delivery-contact__content">
        {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
        {% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}
        {% if section.settings.phone != blank %}<a href="tel:{{ section.settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}">{{ section.settings.phone | escape }}</a>{% endif %}
      </div>
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 700 | image_tag: widths: '180, 280, 400, 560, 700', sizes: '220px', loading: 'lazy', alt: section.settings.image_alt, class: 'delivery-contact__image' }}
      {% elsif request.design_mode %}{{ 'product-1' | placeholder_svg_tag: 'delivery-contact__image' }}{% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .delivery-contact{padding-block:var(--dc-top) var(--dc-bottom);background:#f5efe5}
  .delivery-contact__inner{width:min(calc(100% - 2 * var(--dc-gutter)),var(--dc-width));margin-inline:auto}
  .delivery-contact__card{position:relative;display:flex;align-items:center;justify-content:space-between;gap:32px;min-height:190px;padding:var(--dc-pad);overflow:hidden;border-radius:var(--dc-radius);background:var(--dc-card);color:var(--dc-color)}
  .delivery-contact__content{position:relative;z-index:1;min-width:0}.delivery-contact__content h2{margin:0;font-size:34px;font-weight:400;line-height:1.15}.delivery-contact__content p{margin:16px 0 4px;font-size:16px;line-height:1.35}.delivery-contact__content a{color:inherit;font-size:38px;font-weight:400;line-height:1.1;text-decoration:none}.delivery-contact__content a:focus-visible{outline:2px solid currentColor;outline-offset:4px}
  .delivery-contact__image{align-self:flex-end;display:block;flex:0 0 auto;width:min(34%,var(--dc-image));height:auto;max-height:210px;object-fit:contain;object-position:center bottom}
  @media(max-width:749px){.delivery-contact__card{align-items:flex-start;min-height:0;padding:calc(var(--dc-pad)*.7)}.delivery-contact__content h2{font-size:28px}.delivery-contact__content a{font-size:30px}.delivery-contact__image{width:min(38%,var(--dc-image));margin-inline-end:-18px}}
  @media(max-width:430px){.delivery-contact__card{display:grid}.delivery-contact__image{justify-self:end;width:min(62%,var(--dc-image));margin:0}}
{% endstylesheet %}

{% schema %}
{"name":"Local delivery contact","tag":"section","class":"section-wrapper","settings":[{"type":"text","id":"heading","label":"Heading","default":"Questions? Don’s happy to help."},{"type":"text","id":"text","label":"Supporting text","default":"Call or text Necesito Coffee Roasters"},{"type":"text","id":"phone","label":"Phone number","default":"239-218-0339"},{"type":"image_picker","id":"image","label":"Character image"},{"type":"text","id":"image_alt","label":"Image alt text","default":"Necesito coffee mascot"},{"type":"color","id":"background_color","label":"Card background","default":"#f8e5ae"},{"type":"color","id":"text_color","label":"Text color","default":"#174c3b"},{"type":"range","id":"corner_radius","label":"Corner radius","min":0,"max":40,"step":2,"unit":"px","default":16},{"type":"range","id":"card_padding","label":"Card padding","min":20,"max":80,"step":4,"unit":"px","default":44},{"type":"range","id":"image_width","label":"Image width","min":100,"max":360,"step":10,"unit":"px","default":240},{"type":"range","id":"page_width","label":"Maximum width","min":720,"max":1600,"step":20,"unit":"px","default":1320},{"type":"range","id":"padding_inline","label":"Horizontal padding","min":16,"max":80,"step":4,"unit":"px","default":40},{"type":"header","content":"Spacing"},{"type":"range","id":"padding_top","label":"Padding top","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Padding bottom","min":0,"max":160,"step":4,"unit":"px","default":64}],"presets":[{"name":"Local delivery contact"}]}
{% endschema %}
