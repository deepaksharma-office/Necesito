{% comment %}
  Native Shopify newsletter signup with shared homepage typography and content alignment.
  @example
  Add the Newsletter signup section to a JSON template through the theme editor.
{% endcomment %}

{{ 'newsletter-signup.css' | asset_url | stylesheet_tag }}

{% liquid
  assign form_id = 'NewsletterSignup-' | append: section.id
  assign input_id = 'NewsletterEmail-' | append: section.id
  assign error_id = 'NewsletterError-' | append: section.id
  assign success_id = 'NewsletterSuccess-' | append: section.id
%}

<section
  class="newsletter-signup"
  style="--newsletter-background: {{ section.settings.background_color }}; --newsletter-content-width: {{ section.settings.content_width }}px; --newsletter-padding-top: {{ section.settings.padding_top }}px; --newsletter-padding-bottom: {{ section.settings.padding_bottom }}px; --newsletter-column-gap: {{ section.settings.column_gap }}px; --newsletter-copy-width: {{ section.settings.copy_width }}%; --newsletter-form-width: {{ section.settings.form_width }}px; --newsletter-field-gap: {{ section.settings.field_gap }}px; --newsletter-field-height: {{ section.settings.field_height }}px; --newsletter-input-background: {{ section.settings.input_background }}; --newsletter-input-color: {{ section.settings.input_text_color }}; --newsletter-placeholder-color: {{ section.settings.placeholder_color }}; --newsletter-border-color: {{ section.settings.input_border_color }}; --newsletter-button-background: {{ section.settings.button_background }}; --newsletter-button-color: {{ section.settings.button_text_color }}; --newsletter-error-color: {{ section.settings.error_color }}; --newsletter-success-color: {{ section.settings.success_color }}; --newsletter-input-size: {{ section.settings.input_size }}px; --newsletter-button-size: {{ section.settings.button_size }}px; --newsletter-decoration-color: {{ section.settings.decoration_color }}; --newsletter-decoration-opacity: {{ section.settings.decoration_opacity | divided_by: 100.0 }}; --newsletter-decoration-size: {{ section.settings.decoration_size }}px;"
>
  {% if section.settings.show_decoration %}
    <div class="newsletter-signup__decoration" aria-hidden="true">
      {% if section.settings.decoration_image != blank %}
        {{ section.settings.decoration_image | image_url: width: 500 | image_tag: widths: '160, 240, 360, 500', sizes: '(min-width: 750px) 240px, 120px', loading: 'lazy', alt: '', class: 'newsletter-signup__decoration-image' }}
      {% else %}
        <svg class="newsletter-signup__decoration-svg" viewBox="0 0 120 190" focusable="false">
          <path d="M82 188c-3-40 1-76 13-107 7-19 14-35 21-48" fill="none" stroke="currentColor" stroke-width="2"/>
          <path d="M100 64c-21-1-35-10-37-27 20-2 34 7 37 27ZM93 86c-19 3-34-3-40-18 17-6 33 0 40 18ZM87 111c-18 5-33 1-41-13 16-8 32-4 41 13ZM83 138c-17 7-31 5-41-7 14-10 30-8 41 7ZM100 56c0-19 8-33 24-38 5 18-3 32-24 38ZM94 82c3-18 13-30 29-33 2 18-8 30-29 33ZM88 108c5-17 16-28 33-29 0 18-11 28-33 29Z" fill="currentColor"/>
        </svg>
      {% endif %}
    </div>
  {% endif %}

  <div class="newsletter-signup__container">
    <div class="newsletter-signup__content">
      {% render 'hero-eyebrow', content: section.settings.eyebrow, color: section.settings.eyebrow_color, font_size: section.settings.eyebrow_size, font_weight: 600, text_transform: 'uppercase', class: 'newsletter-signup__eyebrow' %}

      {% render 'hero-title', content: section.settings.heading, heading_tag: section.settings.heading_tag, color: section.settings.heading_color, highlight_color: section.settings.heading_color, desktop_size: section.settings.heading_size, mobile_size: section.settings.heading_size_mobile, font_weight: 500, line_height: 110, letter_spacing: -2, max_width: 720, alignment: 'left' %}

      {% render 'hero-content', content: section.settings.description, color: section.settings.description_color, desktop_size: section.settings.description_size, mobile_size: section.settings.description_size, line_height: 150, max_width: 680, font_weight: 400, alignment: 'left' %}
    </div>

    <div class="newsletter-signup__form-wrap">
      {% form 'customer', id: form_id, class: 'newsletter-signup__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">

        <div class="newsletter-signup__form-fields">
          <label class="visually-hidden" for="{{ input_id }}">{{ section.settings.email_placeholder | escape }}</label>
          <input
            id="{{ input_id }}"
            class="newsletter-signup__input"
            type="email"
            name="contact[email]"
            value="{{ form.email | escape }}"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            placeholder="{{ section.settings.email_placeholder | escape }}"
            required
            {% if form.errors %}aria-invalid="true" aria-describedby="{{ error_id }}"{% elsif form.posted_successfully? %}aria-describedby="{{ success_id }}"{% endif %}
          >
          <button class="newsletter-signup__submit" type="submit">
            {{ section.settings.submit_label | escape }}
          </button>
        </div>

        {% if form.errors %}
          <div id="{{ error_id }}" class="newsletter-signup__message newsletter-signup__message--error" role="alert" tabindex="-1">
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </div>
        {% endif %}

        {% if form.posted_successfully? %}
          <div id="{{ success_id }}" class="newsletter-signup__message newsletter-signup__message--success" role="status" tabindex="-1">
            {{ section.settings.success_message | escape }}
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter signup",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "inline_richtext", "id": "eyebrow", "label": "Eyebrow", "default": "SUBSCRIBE TO OUR NEWSLETTER" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Fresh coffee. Fresh stories." },
    { "type": "select", "id": "heading_tag", "label": "Heading tag", "options": [{ "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }, { "value": "h4", "label": "H4" }], "default": "h2" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Launch news, coffee stories and a little neighborhood conversation. Join our email list.</p>" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder and label", "default": "Your email address" },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Subscribe" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks for subscribing." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 24, "max": 140, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 24, "max": 140, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "content_width", "label": "Content maximum width", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 1320 },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 24, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "copy_width", "label": "Text column width", "min": 38, "max": 58, "step": 1, "unit": "%", "default": 52 },
    { "type": "range", "id": "form_width", "label": "Form maximum width", "min": 360, "max": 680, "step": 20, "unit": "px", "default": 520 },
    { "type": "range", "id": "field_gap", "label": "Input and button gap", "min": 4, "max": 24, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "field_height", "label": "Input and button height", "min": 42, "max": 60, "step": 2, "unit": "px", "default": 48 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#dce9e2" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#173f35" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#173f35" },
    { "type": "color", "id": "description_color", "label": "Description", "default": "#667a70" },
    { "type": "color", "id": "input_background", "label": "Input background", "default": "#fffdf8" },
    { "type": "color", "id": "input_text_color", "label": "Input text", "default": "#173f35" },
    { "type": "color", "id": "placeholder_color", "label": "Placeholder", "default": "#7c8a84" },
    { "type": "color", "id": "input_border_color", "label": "Input border", "default": "#aabbb3" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#173f35" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "color", "id": "error_color", "label": "Error message", "default": "#8b2e2e" },
    { "type": "color", "id": "success_color", "label": "Success message", "default": "#173f35" },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "heading_size", "label": "Heading desktop size", "min": 28, "max": 58, "step": 2, "unit": "px", "default": 42 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading mobile size", "min": 26, "max": 42, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "description_size", "label": "Description size", "min": 13, "max": 20, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "input_size", "label": "Input text size", "min": 13, "max": 20, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "button_size", "label": "Button text size", "min": 13, "max": 20, "step": 1, "unit": "px", "default": 15 },

    { "type": "header", "content": "Decoration" },
    { "type": "checkbox", "id": "show_decoration", "label": "Show botanical decoration", "default": true },
    { "type": "image_picker", "id": "decoration_image", "label": "Custom decoration image" },
    { "type": "color", "id": "decoration_color", "label": "Decoration color", "default": "#94aea0" },
    { "type": "range", "id": "decoration_opacity", "label": "Decoration opacity", "min": 5, "max": 50, "step": 5, "unit": "%", "default": 20 },
    { "type": "range", "id": "decoration_size", "label": "Decoration size", "min": 120, "max": 360, "step": 20, "unit": "px", "default": 240 }
  ],
  "presets": [{ "name": "Newsletter signup" }]
}
{% endschema %}
