{% comment %}
  Merchant-managed linked community highlight cards.
  @example
  Add highlight blocks and configure an optional destination for each card.
{% endcomment %}

<section class="local-events-highlights">
  <div class="local-events-highlights__inner">
    <header><p>{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.text }}</div></header>
    {% if section.blocks.size > 0 %}
      <div class="local-events-highlights__grid">
        {% for block in section.blocks %}
          <article class="local-events-highlight" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}<a class="local-events-highlight__link" href="{{ block.settings.link }}" aria-label="{{ block.settings.title | escape }}"></a>{% endif %}
            {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 33vw, (min-width: 600px) 50vw, 100vw', loading: 'lazy', class: 'local-events-highlight__image' }}{% endif %}
            <div class="local-events-highlight__body">
              <div class="local-events-highlight__meta"><span>{{ block.settings.category | escape }}</span>{% if block.settings.date != blank %}<time>{{ block.settings.date | escape }}</time>{% endif %}</div>
              <h3>{{ block.settings.title | escape }}</h3>
              {% if block.settings.description != blank %}<div class="rte">{{ block.settings.description }}</div>{% endif %}
              {% if block.settings.location != blank %}<p class="local-events-highlight__location">{{ block.settings.location | escape }}</p>{% endif %}
              {% if block.settings.link != blank %}<span class="local-events-highlight__cta">{{ block.settings.cta | default: 'Learn more' | escape }} <span aria-hidden="true">↗</span></span>{% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="local-events-highlights__empty"><span aria-hidden="true">☕</span><p>{{ section.settings.empty_text | escape }}</p></div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .local-events-highlights { padding-block: clamp(64px, 8vw, 112px); background: #fffaf3; color: #174c3b; }
  .local-events-highlights__inner { width: min(calc(100% - 40px), 1320px); margin-inline: auto; }
  .local-events-highlights header { max-width: 720px; margin-bottom: 40px; }
  .local-events-highlights header > p { margin: 0 0 12px; color: #b45b35; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .local-events-highlights h2 { margin: 0 0 14px; color: inherit; font-size: clamp(34px, 4vw, 54px); letter-spacing: -.035em; }
  .local-events-highlights__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .local-events-highlight { position: relative; overflow: hidden; min-width: 0; border: 1px solid #ded6c9; border-radius: 12px; background: #fff; box-shadow: 0 12px 34px rgb(45 35 25 / 7%); transition: transform .25s ease, box-shadow .25s ease; }
  .local-events-highlight:has(.local-events-highlight__link):hover { transform: translateY(-4px); box-shadow: 0 18px 42px rgb(45 35 25 / 12%); }
  .local-events-highlight__link { position: absolute; z-index: 2; inset: 0; border-radius: inherit; }
  .local-events-highlight__link:focus-visible { outline: 3px solid #c8683b; outline-offset: -5px; }
  .local-events-highlight__image { aspect-ratio: 16 / 10; object-fit: cover; }
  .local-events-highlight__body { padding: 24px; }
  .local-events-highlight__meta { display: flex; justify-content: space-between; gap: 16px; color: #8a5c43; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .local-events-highlight h3 { margin: 16px 0 10px; color: inherit; font-size: 24px; line-height: 1.15; }
  .local-events-highlight__location { color: #6c746e; font-size: 14px; }
  .local-events-highlight__cta { display: inline-block; margin-top: 20px; font-weight: 700; }
  .local-events-highlights__empty { padding: 48px; border: 1px dashed #cbbfb0; border-radius: 12px; text-align: center; }
  .local-events-highlights__empty span { font-size: 34px; }
  @media (max-width: 989px) { .local-events-highlights__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 599px) { .local-events-highlights__grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .local-events-highlight { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Community highlights",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "AROUND ESTERO" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Community Highlights" },
    { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Stay connected with what's happening around our neighborhood.</p>" },
    { "type": "text", "id": "empty_text", "label": "Empty-state text", "default": "Fresh neighborhood stories are coming soon." }
  ],
  "blocks": [{
    "type": "highlight",
    "name": "Highlight",
    "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "category", "label": "Category", "default": "Community" },
      { "type": "text", "id": "title", "label": "Title", "default": "Neighborhood highlight" },
      { "type": "richtext", "id": "description", "label": "Short description", "default": "<p>Share a local story or upcoming happening.</p>" },
      { "type": "text", "id": "date", "label": "Date" },
      { "type": "text", "id": "location", "label": "Location" },
      { "type": "text", "id": "cta", "label": "CTA label", "default": "Learn more" },
      { "type": "url", "id": "link", "label": "Link" }
    ]
  }],
  "presets": [{ "name": "Community highlights" }]
}
{% endschema %}
