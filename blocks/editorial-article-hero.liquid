{% doc %}
  Renders the article hero with editable labels, title, summary, and image.
  @example
  {% content_for 'block', type: 'editorial-article-hero', id: 'hero' %}
{% enddoc %}

{% liquid
  assign hero_title = block.settings.title
  if block.settings.use_article_title
    assign hero_title = article.title
  endif
  assign hero_image = block.settings.image
  if block.settings.use_article_image
    assign hero_image = article.image
  endif
%}

<header class="editorial-hero" style="--hero-background: {{ block.settings.background }}; --hero-foreground: {{ block.settings.foreground }}; --hero-accent: {{ block.settings.accent }}; --hero-radius: {{ block.settings.image_radius }}px;" {{ block.shopify_attributes }}>
  <div class="editorial-hero__inner">
    {% if block.settings.show_breadcrumbs %}<div class="editorial-hero__crumbs"><a href="{{ blog.url }}">{{ blog.title | escape }}</a><span aria-hidden="true">/</span><span>{{ hero_title | escape }}</span></div>{% endif %}
    {% if block.settings.label_1 != blank or block.settings.label_2 != blank %}<div class="editorial-hero__labels">{% if block.settings.label_1 != blank %}<span>{{ block.settings.label_1 | escape }}</span>{% endif %}{% if block.settings.label_2 != blank %}<span>{{ block.settings.label_2 | escape }}</span>{% endif %}</div>{% endif %}
    <h1>{{ hero_title | escape }}</h1>
    {% if block.settings.summary != blank %}<div class="editorial-hero__summary rte">{{ block.settings.summary }}</div>{% endif %}
    {% if hero_image != blank %}{{ hero_image | image_url: width: 1800 | image_tag: widths: '480, 720, 960, 1200, 1600, 1800', sizes: '(min-width: 990px) 900px, calc(100vw - 32px)', loading: 'eager', fetchpriority: 'high', class: 'editorial-hero__image' }}{% endif %}
  </div>
</header>

{% stylesheet %}
  .editorial-hero { width: 100vw; margin-inline: calc(50% - 50vw); padding: clamp(44px, 7vw, 88px) 20px; color: var(--hero-foreground); background: var(--hero-background); }
  .editorial-hero__inner { width: min(100%, 900px); margin-inline: auto; }
  .editorial-hero__crumbs { display: flex; gap: 8px; align-items: center; padding: 8px 12px; border: 1px solid rgb(255 255 255 / 18%); border-radius: 6px; background: rgb(255 255 255 / 7%); font-size: 12px; width: fit-content; }
  .editorial-hero__crumbs a { color: inherit; text-decoration: none; }
  .editorial-hero__crumbs span:last-child { overflow: hidden; max-width: 52ch; text-overflow: ellipsis; white-space: nowrap; }
  .editorial-hero__labels { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .editorial-hero__labels span { padding: 5px 12px; color: var(--hero-background); border-radius: 999px; background: var(--hero-accent); font-size: 12px; font-weight: 650; }
  .editorial-hero h1 { max-width: 18ch; margin: 20px 0 0; color: inherit; font-size: clamp(38px, 6vw, 68px); line-height: 0.98; letter-spacing: -0.04em; text-wrap: balance; }
  .editorial-hero__summary { max-width: 74ch; margin-top: 22px; color: inherit; font-size: clamp(15px, 1.8vw, 18px); line-height: 1.6; }
  .editorial-hero__summary > * { margin-block: 0; }
  .editorial-hero__image { display: block; width: 100%; max-height: 440px; margin-top: 34px; object-fit: cover; border-radius: var(--hero-radius); }
  @media screen and (max-width: 749px) { .editorial-hero { padding-inline: 16px; } .editorial-hero h1 { font-size: clamp(36px, 12vw, 52px); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Article hero",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "text", "id": "label_1", "label": "First label", "default": "Guides" },
    { "type": "text", "id": "label_2", "label": "Second label", "default": "News" },
    { "type": "checkbox", "id": "use_article_title", "label": "Use article title", "default": true },
    { "type": "text", "id": "title", "label": "Custom title", "default": "A complete guide", "visible_if": "{{ block.settings.use_article_title == false }}" },
    { "type": "richtext", "id": "summary", "label": "Summary", "default": "<p>Add a concise introduction to the article.</p>" },
    { "type": "checkbox", "id": "use_article_image", "label": "Use article featured image", "default": true },
    { "type": "image_picker", "id": "image", "label": "Custom image", "visible_if": "{{ block.settings.use_article_image == false }}" },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 8 },
    { "type": "color", "id": "background", "label": "Background", "default": "#2f160d" },
    { "type": "color", "id": "foreground", "label": "Text", "default": "#fffaf4" },
    { "type": "color", "id": "accent", "label": "Labels", "default": "#d7b77d" }
  ],
  "presets": [{ "name": "Article hero" }]
}
{% endschema %}
