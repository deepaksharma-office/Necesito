{% doc %}
  Renders configurable rich-text supporting content for a hero.

  @param {string} content - Rich-text content.
  @param {color} color - Text color.
  @param {number} desktop_size - Desktop font size in pixels.
  @param {number} mobile_size - Mobile font size in pixels.
  @param {number} line_height - Line height as a percentage.
  @param {number} max_width - Maximum width in pixels.
  @param {number} font_weight - Font weight.
  @param {string} alignment - Text alignment.

  @example
  {% render 'hero-content', content: section.settings.description, color: section.settings.description_color, desktop_size: 18, mobile_size: 16, line_height: 160, max_width: 540, font_weight: 400, alignment: 'left' %}
{% enddoc %}

{% if content != blank %}
  <div
    class="hero-composition__content rte"
    style="--hero-content-color: {{ color }}; --hero-content-size: {{ desktop_size }}px; --hero-content-size-mobile: {{ mobile_size }}px; --hero-content-leading: {{ line_height | divided_by: 100.0 }}; --hero-content-max-width: {{ max_width }}px; --hero-content-weight: {{ font_weight }}; --hero-content-align: {{ alignment }};"
  >
    {{ content }}
  </div>
{% endif %}
